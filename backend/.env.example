# Flask Server Configuration
FLASK_ENV=development
SECRET_KEY=replace_with_a_secure_random_64_char_hex_key
PORT=5000

# MongoDB Configuration
MONGODB_URI=mongodb://localhost:27017/
MONGODB_DATABASE=evoting_db

# Security & CORS
FRONTEND_ORIGIN=http://localhost:5173
SESSION_COOKIE_SECURE=false
JWT_EXPIRATION_HOURS=8
TIMEZONE=UTC

# Biometric & Face Recognition Configuration
# Configurable face recognition model: 'sface' (OpenCV Deep Face / SFace), 'yunet' for detector
# Threshold: Cosine similarity threshold (standard SFace cosine threshold is ~0.363 - 0.40)
FACE_MODEL_NAME=sface
FACE_SIMILARITY_THRESHOLD=0.363
FACE_MAX_UPLOAD_BYTES=5242880
